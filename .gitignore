# 依赖
node_modules/

# 构建产物 / 打包产物
dist/
release*/

# 原始素材（体积巨大，且含第三方数据包；用 scripts/ 里的管线可重新获取）
# 其中 data/raw/repo 是用于枚举真题清单的独立 git 仓库
data/raw/

# 解析过程中被判定失效的旧 JSON（命名/内容不匹配，不应入库）
data/seed/_stale/

# 运行期生成
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Vite 构建中途失败时可能残留的临时配置
*.timestamp-*

# 验证 / 截图 / 诊断脚本使用的隔离用户数据
.tmp-*/

# 编辑器
.vscode/
.idea/

# 密钥：绝不进仓库（API Key 只应存在于本机用户库 %APPDATA%/cet-wordkeeper 或环境变量）
.env
.env.*
*.key
*.pem
secrets.json
# 注意：scripts/check-secrets.mjs 会在每次 verify-all 时兜底扫描被跟踪文件


release-v3/
release-v4/
release-v5/
release-v6/
release-v7/
release-v7b/
release-v8/
release-v9/
release-v10/
